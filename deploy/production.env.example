# Production environment for the Aerowell container on EC2.
#
# This file's contents go into SSM Parameter Store, NOT onto GitHub or into the image:
#
#   aws ssm put-parameter --region ap-southeast-2 --name /aerowell/production/env \
#     --type SecureString --tier Standard --overwrite --value file://production.env
#
# Every deploy re-reads it, so to change a setting: update the parameter, then re-run
# the "Deploy to AWS" workflow (Actions tab > Run workflow).
# Required: MONGODB_URI, JWT_SECRET, FRONTEND_URL, API_PUBLIC_URL.
# Everything under "Optional features" stays switched off while empty.

NODE_ENV=production
PORT=5000

# MongoDB Atlas (or self-hosted). Allow the EC2 instance's public IP / VPC in Atlas network access.
MONGODB_URI=
# At least 48 random characters:  openssl rand -base64 48
JWT_SECRET=

# The ALB sits in front of the container
TRUST_PROXY=1

# Background queue. "false" uses the in-memory queue; set true with an ElastiCache Redis URL.
USE_REDIS=false
REDIS_URL=

# Wallpaper images on S3, using the EC2 instance role (no keys stored anywhere)
AWS_S3_BUCKET=aerowell
AWS_REGION=ap-southeast-2
AWS_USE_INSTANCE_ROLE=true
S3_KEY_PREFIX=feelowall
# Strongly recommended for a read-heavy site: a CloudFront distribution in front of the bucket
# S3_PUBLIC_URL=https://dxxxxxxxxxxxx.cloudfront.net

# Must equal the APP_URL GitHub variable (same container serves frontend and API)
FRONTEND_URL=
API_PUBLIC_URL=

# Optional features
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SMTP_URL=
MAIL_FROM=Aerowell <no-reply@example.com>
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=0
STRIPE_AUTOMATIC_TAX=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
ERROR_WEBHOOK_URL=
