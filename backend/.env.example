# Copy to .env and fill in. Only PORT, MONGODB_URI, and JWT_SECRET are required;
# every other feature reports itself as unavailable until its values are set.

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/feelowall
JWT_SECRET=change-me-to-a-long-random-string

# Used by `npm test`. Must point at a database whose name ends in _test.
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/feelowall_test

# Background queue
USE_REDIS=false
REDIS_URL=redis://127.0.0.1:6379

# Image storage on Amazon S3 (falls back to local disk when unset).
# Files are served from https://<bucket>.s3.<region>.amazonaws.com/<key>, so the
# bucket policy must allow public s3:GetObject on <S3_KEY_PREFIX>/*.
AWS_S3_BUCKET=aerowell
AWS_REGION=ap-southeast-2
# Local dev: an IAM user's keys. On EC2: leave both empty and set AWS_USE_INSTANCE_ROLE=true.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_USE_INSTANCE_ROLE=false
# Optional: serve from a CDN or custom domain instead (e.g. https://cdn.example.com)
# S3_PUBLIC_URL=
S3_KEY_PREFIX=feelowall

# Behind a reverse proxy, set this to the number of proxies so rate limits see real visitor IPs.
# Behind the AWS ALB this must be 1.
# TRUST_PROXY=1
# Multiplies every rate limit
# RATE_LIMIT_SCALE=1

# Public addresses
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:5000

# OAuth. Register this redirect URL with each provider:
#   <FRONTEND_URL>/oauth/callback/google  (or /github, /discord)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Email for verification and password reset, e.g. smtps://user:pass@smtp.example.com
# Without this, links are printed to the server log in development only.
SMTP_URL=
MAIL_FROM=FeeloWall <no-reply@example.com>

# Payments (Stripe Connect)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Percentage kept by the platform on tips and pack sales
PLATFORM_FEE_PERCENT=0
# Needs Stripe Tax enabled on your Stripe account
STRIPE_AUTOMATIC_TAX=false

# AI features (auto-tagging, moderation pre-check, natural-language search)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Optional: receive redacted server errors at this webhook
ERROR_WEBHOOK_URL=
